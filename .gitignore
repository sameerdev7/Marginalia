# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/

# Virtual environments
.venv

# secrets — never committed
.env

# local sqlite db, regenerated via alembic + seed_books.py
*.db

# Claude Code session runtime state, not project config
.claude/scheduled_tasks.lock

# local notes/guides, not meant to be pushed
docs/

# frontend — its own repo, nested here on disk, not tracked by this one
marginalia-web/

# user-uploaded files
uploads/

# tooling caches and editor/OS noise
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
nohup.out
*.log
.DS_Store
.idea/
.vscode/
.claude/settings.local.json

# env variants (keep an .env.example if you add one)
.env.*
!.env.example
